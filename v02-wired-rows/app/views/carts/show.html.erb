<% content_for :title, "Your Cart · GoodDeal" %>
<%= turbo_stream_from Screens::Catalog::STREAM %>
<h1 class="pb-6 text-3xl font-semibold tracking-tight">Your Cart</h1>
<%= render "elements/notice_with_action", shown: @s.undo_pending, text: @texts[:undo][:text], action: @texts[:undo][:undo],
      url: cart_undo_path, expire_url: expire_cart_undo_path, after_ms: Screens::Store::UNDO_WINDOW.in_milliseconds %>
<div class="grid items-start gap-8 lg:grid-cols-[1fr_22rem]">
  <section class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm" data-controller="tabs">
    <%= render "elements/tabs", tabs: [ [ :items, @texts[:tabs][:items], @s.summary[:item_count] ],
                                        [ :saved, @texts[:tabs][:saved], @s.saved_count ],
                                        [ :wishlist, @texts[:tabs][:wishlist], @s.wishlist_count ] ] %>
    <div data-tabs-target="pane" data-name="items">
      <%= render partial: "components/cart_line", collection: @s.rows, as: :row,
            locals: { wishlist_ids: @s.wishlist_ids, t: @texts[:cart], labels: Screens::Store::STOCK_LABELS } %>
      <%= render "elements/none", count: @s.summary[:item_count], text: @texts[:cart][:empty] %>
    </div>
    <div data-tabs-target="pane" data-name="saved" hidden>
      <%= render partial: "components/saved_line", collection: @s.saved_rows, as: :row, locals: { t: @texts[:saved] } %>
      <%= render "elements/none", count: @s.saved_count, text: @texts[:saved][:empty] %>
    </div>
    <div data-tabs-target="pane" data-name="wishlist" hidden>
      <%= render partial: "components/wishlist_line", collection: @s.wishlist_rows, as: :row, locals: { t: @texts[:wishlist] } %>
      <%= render "elements/none", count: @s.wishlist_count, text: @texts[:wishlist][:empty] %>
    </div>
  </section>
  <section class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm lg:sticky lg:top-6">
    <%= render "components/cart_summary", summary: @s.summary, t: @texts[:cart] %>
    <%= render "components/shipping_selector", summary: @s.summary, heading: @texts[:cart][:shipping], free_over: @texts[:cart][:free_over], url: shipping_cart_path %>
    <%= render "components/promo_form", code: @s.summary[:promo_code], error: flash[:promo_error], url: promo_cart_path, t: @texts[:cart] %>
    <%= button_to "#{@texts[:cart][:checkout]} · #{@s.summary[:total]}", cart_checkout_path, disabled: @s.summary[:empty],
          class: "mt-6 w-full rounded-xl bg-brand-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800 disabled:cursor-not-allowed disabled:bg-stone-300" %>
  </section>
</div>
