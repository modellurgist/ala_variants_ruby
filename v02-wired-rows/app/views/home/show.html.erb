<div class="grid items-center gap-12 py-6 md:grid-cols-2">
  <div>
    <h1 class="pb-4 text-4xl font-semibold tracking-tight sm:text-5xl">Welcome to GoodDeal!</h1>
    <p class="pb-8 text-lg text-stone-600">
      The greatest store to buy all your things and stuff. Our live inventory shows when products are available.
    </p>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Browse products", products_path, class: "rounded-xl bg-brand-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800" %>
      <%= link_to "Bulk orders", portal_path, class: "rounded-xl border border-stone-300 bg-white px-5 py-3 text-sm font-semibold text-stone-700 hover:bg-stone-50" %>
    </div>
  </div>
</div>
