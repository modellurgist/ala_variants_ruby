<% content_for :title, "Checkout · GoodDeal" %>
<%= turbo_stream_from Screens::Checkout.stream(@s.config[:cart_id]) %>
<div class="mx-auto max-w-lg">
  <%= link_to @t[:back], cart_path, class: "text-sm font-medium text-stone-500 hover:text-stone-800" %>
  <h1 class="py-4 text-3xl font-semibold tracking-tight"><%= @t[:heading] %></h1>
  <%= render "components/milestones", step: @s.step, milestones: Screens::Checkout::MILESTONES, order: Screens::Checkout::STEP_ORDER %>
  <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <%= render "checkouts/#{@s.step}" %>
  </div>
</div>
