<div class="space-y-4">
  <div class="rounded-xl bg-stone-50 p-4 text-sm text-stone-700">
    <div class="font-medium"><%= @s.form.name %></div>
    <div><%= @s.form.line1 %></div>
    <div><%= @s.form.city %>, <%= @s.form.postal_code %></div>
  </div>
  <div class="flex justify-between border-t border-stone-200 pt-4 text-lg font-semibold">
    <span><%= @t[:total] %></span><span><%= @s.summary[:total] %></span>
  </div>
  <div class="flex items-center justify-between gap-3">
    <%= button_to @t[:edit_address], edit_address_cart_checkout_path, class: "text-sm font-medium text-stone-500 hover:text-stone-800" %>
    <%= button_to "#{@t[:pay]} #{@s.summary[:total]}", pay_cart_checkout_path, class: "rounded-xl bg-brand-700 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-brand-800" %>
  </div>
</div>
