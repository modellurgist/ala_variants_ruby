<%# A form for one record: an input per configured field, the record's errors, and a submit button.
    Takes the record, the fields ([name, type, label]), the words and the URLs it posts to; validates
    live against validate_url while the shopper types. %>
<%= form_with model: record, url: url, id: local_assigns[:id] || dom_id(record, :form), data: { turbo_frame: "_top", controller: "live-validate", live_validate_url_value: validate_url, action: "input->live-validate#check submit->live-validate#cancel" }, class: "space-y-4" do |f| %>
  <% if record.errors.any? %>
    <div class="rounded-lg bg-red-50 p-3 text-sm text-red-700">
      <% record.errors.full_messages.each do |message| %><div><%= message %></div><% end %>
    </div>
  <% end %>
  <% fields.each do |name, type, label| %>
    <div>
      <%= f.label name, label, class: "block text-sm font-medium text-stone-700" %>
      <%= f.send(:"#{type}_field", name, class: "mt-1 block w-full rounded-lg border border-stone-300 text-sm focus:border-brand-600 focus:ring-brand-600") %>
      <% record.errors[name].each do |message| %><p class="mt-1 text-xs text-red-600"><%= label %> <%= message %></p><% end %>
    </div>
  <% end %>
  <div class="flex justify-end pt-2">
    <%= f.submit submit, class: "rounded-xl bg-brand-700 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-800", data: { turbo_submits_with: "Saving…" } %>
  </div>
<% end %>
