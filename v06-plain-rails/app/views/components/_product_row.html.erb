<%# A catalog row: a product's thumbnail, name, description, price and stock, and, when given the words
    for them (`actions`), its edit, delete and add-to-cart actions. Takes a projected row (with its
    URLs), the stock labels, and the Turbo frame the edit opens in. %>
<div id="<%= product_row_id(row[:id]) %>" class="grid grid-cols-[4rem_1fr] items-center gap-4 border-b border-stone-200 py-5 last:border-b-0 sm:grid-cols-[4rem_1fr_auto]">
  <img class="h-16 w-16 rounded-lg object-cover ring-1 ring-stone-200" src="<%= row[:thumbnail] %>" alt="<%= row[:name] %>">
  <div class="min-w-0">
    <div class="truncate font-medium text-stone-900"><%= link_to row[:name], row[:urls][:show], class: "hover:underline" %></div>
    <div class="truncate text-sm text-stone-500"><%= row[:description] %></div>
    <div class="mt-1 flex items-center gap-3 text-sm text-stone-500">
      <%= row[:amount] %>
      <%= render "elements/stock_badge", product_id: row[:id], status: row[:stock_status], stock: row[:stock], labels: labels %>
    </div>
  </div>
  <% if local_assigns[:actions] %>
    <div class="col-span-2 flex items-center justify-end gap-3 sm:col-span-1">
      <%= link_to actions[:edit], row[:urls][:edit], data: { turbo_frame: frame }, class: "text-sm font-medium text-stone-500 hover:text-stone-800" %>
      <%= button_to actions[:delete], row[:urls][:delete], method: :delete, data: { turbo_confirm: actions[:confirm_delete] }, class: "text-sm font-medium text-stone-400 hover:text-red-600" %>
      <%= button_to actions[:add_to_cart], row[:urls][:add_to_cart], class: "rounded-lg bg-brand-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-brand-800" %>
    </div>
  <% end %>
</div>
