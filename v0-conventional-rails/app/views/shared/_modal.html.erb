<% provide :modal, "open" %>
<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 z-40 flex items-start justify-center bg-stone-900/40 p-6">
    <div class="mt-16 w-full max-w-lg rounded-lg border border-stone-200 bg-white p-6 shadow-xl">
      <h2 class="mb-4 text-lg font-semibold"><%= title %></h2>
      <%= yield %>
    </div>
  </div>
<% end %>
