<% content_for :title, "Review order" %>
<div class="mx-auto max-w-lg space-y-4">
  <h1 class="text-2xl font-semibold">Review order · <%= money(@cart.totals.total) %></h1>
  <%= render "shared/steps", steps: %w[Order Review Submitted], current: "Review" %>
  <div class="rounded-lg border border-stone-200 bg-white p-4"><%= render "shared/totals", totals: @cart.totals %></div>

  <%= form_with model: @order, url: portal_order_path, class: "space-y-3",
        data: { controller: "live-validation", action: "input->live-validation#validate", live_validation_url_value: validate_portal_path } do |form| %>
    <div id="order_errors"><%= render "shared/errors", record: @order %></div>
    <div>
      <%= form.label :po_number, "Purchase order number", class: "block text-sm font-medium" %>
      <%= form.text_field :po_number, placeholder: "PO-1234", class: "mt-1 block w-full rounded-md border border-stone-300 px-3 py-2" %>
    </div>
    <div class="flex items-center gap-4">
      <%= form.submit "Submit order", class: "rounded-md bg-emerald-700 px-4 py-2 text-sm font-medium text-white" %>
      <%= link_to "Edit lines", portal_path, class: "text-sm underline" %>
    </div>
  <% end %>
</div>
