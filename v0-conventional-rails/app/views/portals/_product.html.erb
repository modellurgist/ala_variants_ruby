<%= form_with url: portal_lines_path, id: dom_id(product, :portal), class: "flex items-center gap-3 rounded-lg border border-stone-200 bg-white p-3 text-sm" do |form| %>
  <%= form.hidden_field :product_id, value: product.id, id: nil %>
  <span class="flex-1 font-medium"><%= product.name %></span>
  <span><%= money(product.amount) %></span>
  <%= stock_badge(product) %>
  <%= form.number_field :quantity, value: 1, min: 1, id: nil, aria: { label: "Quantity for #{product.name}" }, class: "w-16 rounded-md border border-stone-300 px-2 py-1" %>
  <%= form.submit "Add to order", disabled: product.stock_status == :out_of_stock, class: "rounded-md bg-emerald-700 px-3 py-1 font-medium text-white disabled:opacity-40" %>
<% end %>
