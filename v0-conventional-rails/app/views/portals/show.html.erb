<% content_for :title, "Bulk orders" %>
<%= turbo_stream_from "portal_products" %>
<%= turbo_stream_from @cart %>

<h1 class="mb-4 text-2xl font-semibold">Bulk orders</h1>
<%= render "shared/steps", steps: %w[Order Review Submitted], current: "Order" %>

<div id="undo_banner">
  <%= render "shared/undo_banner", undo_path: portal_undo_path if @cart.pending_removal %>
</div>

<div class="grid gap-8 lg:grid-cols-2">
  <section>
    <h2 class="mb-2 font-semibold">Catalog</h2>
    <div id="portal_products" class="space-y-2"><%= render partial: "portals/product", collection: @products %></div>
  </section>

  <section class="space-y-4">
    <h2 class="font-semibold">Order lines</h2>
    <div id="portal_lines" class="space-y-2"><%= render partial: "portal/lines/line", collection: @cart.items %></div>
    <div class="space-y-4 rounded-lg border border-stone-200 bg-white p-4">
      <div id="portal_summary"><%= render "portals/summary", cart: @cart %></div>
      <%= render "shared/shipping_form", cart: @cart, url: portal_shipping_method_path %>
    </div>
  </section>
</div>
