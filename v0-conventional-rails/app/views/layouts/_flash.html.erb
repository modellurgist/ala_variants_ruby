<% flash.each do |type, message| %>
  <div role="<%= type == "alert" ? "alert" : "status" %>"
       class="mt-4 rounded-md border px-4 py-2 text-sm <%= type == "alert" ? "border-red-200 bg-red-50 text-red-700" : "border-emerald-200 bg-emerald-50 text-emerald-800" %>">
    <%= message %>
  </div>
<% end %>
