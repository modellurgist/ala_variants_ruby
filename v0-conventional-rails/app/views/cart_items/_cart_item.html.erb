<div id="<%= dom_id cart_item %>" class="flex flex-wrap items-center gap-4 rounded-lg border border-stone-200 bg-white p-3 text-sm">
  <%= image_tag cart_item.product.thumbnail, alt: "", class: "size-12 rounded object-cover" if cart_item.product.thumbnail.present? %>
  <div class="min-w-40 flex-1">
    <p class="font-medium">
      <%= cart_item.product.name %>
      <% if cart_item.wishlisted? %><span class="ml-1 text-xs text-pink-700">♥ In wishlist</span><% end %>
    </p>
    <p class="text-stone-600"><%= money(cart_item.product.amount) %> each · <%= stock_badge(cart_item.product) %></p>
    <% if cart_item.gift_wrap? %><p class="text-xs text-emerald-700">Gift-wrapped</p><% end %>
  </div>
  <div class="flex items-center gap-1">
    <%= button_to "−", cart_item_path(cart_item), method: :patch, params: { quantity: cart_item.quantity - 1 }, disabled: cart_item.quantity <= 1,
          aria: { label: "Decrease quantity" }, class: "size-7 rounded border border-stone-300 disabled:opacity-40" %>
    <span class="w-8 text-center" data-testid="quantity"><%= cart_item.quantity %></span>
    <%= button_to "+", cart_item_path(cart_item), method: :patch, params: { quantity: cart_item.quantity + 1 },
          aria: { label: "Increase quantity" }, class: "size-7 rounded border border-stone-300" %>
  </div>
  <span class="w-20 text-right font-medium"><%= money(cart_item.line_total) %></span>
  <div class="flex w-full flex-wrap gap-3 text-xs">
    <%= button_to cart_item.gift_wrap? ? "Remove gift wrap" : "Gift wrap", gift_wrap_cart_item_path(cart_item), method: :patch, class: "underline" %>
    <%= button_to "Save for later", save_for_later_cart_item_path(cart_item), method: :patch, class: "underline" %>
    <%= button_to cart_item.wishlisted? ? "Remove from wishlist" : "Add to wishlist", wishlist_cart_item_path(cart_item), method: :patch, class: "underline" %>
    <%= button_to "Remove", cart_item_path(cart_item), method: :delete, class: "text-red-700 underline" %>
  </div>
</div>
