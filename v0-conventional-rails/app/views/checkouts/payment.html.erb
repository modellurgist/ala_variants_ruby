<% content_for :title, "Checkout · Payment" %>
<%= turbo_stream_from @checkout %>
<div class="mx-auto max-w-lg space-y-4">
  <h1 class="text-2xl font-semibold">Checkout</h1>
  <%= render "shared/steps", steps: %w[Address Payment], current: "Payment" %>

  <section class="rounded-lg border border-stone-200 bg-white p-4 text-sm">
    <h2 class="mb-1 font-medium">Ship to</h2>
    <p><%= @checkout.name %></p>
    <p><%= @checkout.address %>, <%= @checkout.city %> <%= @checkout.postal_code %></p>
  </section>

  <p class="text-lg font-semibold">Total: <%= money(current_cart.totals.total) %></p>

  <%= render "checkouts/payment_status", checkout: @checkout %>
</div>
