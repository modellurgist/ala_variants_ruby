<div id="<%= dom_id wishlist_item %>" class="flex items-center justify-between gap-3 rounded-lg border border-stone-200 bg-white p-3 text-sm">
  <span class="flex-1 font-medium"><%= wishlist_item.product.name %></span>
  <span><%= money(wishlist_item.product.amount) %></span>
  <%= button_to "Add to cart", add_to_cart_cart_wishlist_item_path(wishlist_item), class: "underline" %>
  <%= button_to "Remove", cart_wishlist_item_path(wishlist_item), method: :delete, class: "text-red-700 underline" %>
</div>
