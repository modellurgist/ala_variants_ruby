<div id="<%= dom_id line %>" class="flex items-center gap-3 rounded-lg border border-stone-200 bg-white p-3 text-sm">
  <span class="flex-1 font-medium"><%= line.product.name %></span>
  <%= stock_badge(line.product) %>
  <%= form_with url: portal_line_path(line), method: :patch, data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |form| %>
    <%= form.number_field :quantity, value: line.quantity, min: 1, id: nil, aria: { label: "Quantity of #{line.product.name}" }, class: "w-20 rounded-md border border-stone-300 px-2 py-1" %>
  <% end %>
  <span class="w-24 text-right font-medium"><%= money(line.line_total) %></span>
  <%= button_to "Remove", portal_line_path(line), method: :delete, class: "text-red-700 underline" %>
</div>
