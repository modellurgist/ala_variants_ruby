<% totals = cart.totals %>
<% if totals.empty? %>
  <p class="mb-3 text-sm text-stone-600">Your cart is empty.</p>
<% end %>
<%= render "shared/totals", totals: %>
<%= button_to "Checkout", cart_checkout_path, disabled: totals.empty?, class: "mt-4 w-full rounded-md bg-emerald-700 px-4 py-2 text-sm font-medium text-white disabled:opacity-50" %>
