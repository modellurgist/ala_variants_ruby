<% content_for :title, "Your cart" %>
<%= turbo_stream_from @cart %>

<h1 class="mb-4 text-2xl font-semibold">Your cart</h1>

<div id="undo_banner">
  <%= render "shared/undo_banner", undo_path: cart_undo_path if @cart.pending_removal %>
</div>

<div class="grid gap-8 lg:grid-cols-3">
  <section class="lg:col-span-2" data-controller="tabs">
    <div class="mb-4 flex gap-2 border-b border-stone-200" role="tablist">
      <% { "items" => "Items", "saved" => "Saved", "wishlist" => "Wishlist" }.each do |tab, label| %>
        <button type="button" role="tab" data-tab="<%= tab %>" data-tabs-target="tab" data-action="tabs#select"
                aria-selected="<%= tab == "items" %>" class="px-3 py-2 text-sm font-medium aria-selected:border-b-2 aria-selected:border-emerald-700">
          <%= label %> (<span id="<%= tab %>_count"><%= cart_tab_count(@cart, tab) %></span>)
        </button>
      <% end %>
    </div>

    <div data-tabs-target="panel" data-tab="items">
      <div id="cart_items" class="space-y-3"><%= render @cart.items %></div>
    </div>
    <div data-tabs-target="panel" data-tab="saved" hidden>
      <div id="saved_items" class="space-y-3"><%= render partial: "cart_items/saved_item", collection: @cart.saved_items %></div>
    </div>
    <div data-tabs-target="panel" data-tab="wishlist" hidden>
      <div id="wishlist_items" class="space-y-3"><%= render @cart.wishlist_items %></div>
    </div>
  </section>

  <aside class="space-y-6 rounded-lg border border-stone-200 bg-white p-4">
    <div id="cart_summary"><%= render "carts/summary", cart: @cart %></div>
    <div id="promo_form"><%= render "carts/promo_form", error: nil %></div>
    <%= render "shared/shipping_form", cart: @cart, url: cart_shipping_method_path %>
  </aside>
</div>
